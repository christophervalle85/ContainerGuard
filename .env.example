# Local demonstration configuration only. Use different credentials in deployment.
POSTGRES_DB=containerguard
POSTGRES_USER=containerguard
POSTGRES_PASSWORD=containerguard_local
# Host port 5433 avoids the common local PostgreSQL port 5432.
POSTGRES_PORT=5433
# The API runs on the host; inside containers the database host would be db.
DATABASE_URL=postgresql+psycopg://containerguard:containerguard_local@127.0.0.1:5433/containerguard

# Separate disposable database for tests; never point this at development data.
TEST_POSTGRES_PORT=5434
TEST_DATABASE_URL=postgresql+psycopg://containerguard_test:containerguard_test_local@127.0.0.1:5434/containerguard_test
