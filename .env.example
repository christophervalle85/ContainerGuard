# Local demonstration configuration only. Use different credentials in deployment.
POSTGRES_DB=containerguard
POSTGRES_USER=containerguard
POSTGRES_PASSWORD=containerguard_local
# Host port 5433 avoids the common local PostgreSQL port 5432.
POSTGRES_PORT=5433
# Host-based Python commands use the published PostgreSQL port.
DATABASE_URL=postgresql+psycopg://containerguard:containerguard_local@127.0.0.1:5433/containerguard

# Separate disposable database for tests; never point this at development data.
TEST_POSTGRES_PORT=5434
TEST_DATABASE_URL=postgresql+psycopg://containerguard_test:containerguard_test_local@127.0.0.1:5434/containerguard_test

# Local Redis queue service. Host port 6380 avoids a Redis installation on 6379.
REDIS_PORT=6380
# Host-based Python commands use the published Redis port.
REDIS_URL=redis://127.0.0.1:6380/0

# Separate disposable Redis server for tests; never use the development queue.
TEST_REDIS_PORT=6381
TEST_REDIS_URL=redis://127.0.0.1:6381/0

# Containerized API, worker, and migrations use service names and internal ports.
# Keep these database credentials consistent with POSTGRES_* above.
# Percent-encode special characters in URL usernames/passwords (for example @ as %40).
CONTAINER_DATABASE_URL=postgresql+psycopg://containerguard:containerguard_local@db:5432/containerguard
CONTAINER_REDIS_URL=redis://redis:6379/0
API_PORT=8000
