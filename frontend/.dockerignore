# Include only compilation, test/typecheck and web-server inputs.
**
!.dockerignore
!.npmrc
!package.json
!package-lock.json
!index.html
!nginx.conf
!tsconfig.json
!*.config.ts
!src/
!src/**
!tests/
!tests/**
!public/
!public/**

# Local configuration never belongs in a build context.
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/credentials*
**/secrets*
**/*.log
**/.cache
**/__pycache__
**/*.py[cod]
**/node_modules
**/dist
**/coverage
**/playwright-report
**/test-results
**/.DS_Store
