# Root Git context; only reviewed frontend build inputs are visible.
# Include only compilation, test/typecheck and web-server inputs.
**
!frontend/.dockerignore
!frontend/.npmrc
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/nginx.conf
!frontend/tsconfig.json
!frontend/*.config.ts
!frontend/src/
!frontend/src/**
!frontend/tests/
!frontend/tests/**
!frontend/public/
!frontend/public/**

# Local configuration never belongs in a build context.
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/credentials*
**/secrets*
**/*.log
**/.cache
**/__pycache__
**/*.py[cod]
**/node_modules
**/dist
**/coverage
**/playwright-report
**/test-results
**/.DS_Store
