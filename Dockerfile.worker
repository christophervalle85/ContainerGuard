# Pin the multi-platform index so native ARM64 and AMD64 builds use the same release.
ARG PYTHON_IMAGE=python:3.14.7-alpine@sha256:9e9fde4d32eedce0b661d9ab91e826b62dddf28e928c230ec55f1866cac66b01

FROM ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 AS uv

FROM --platform=$BUILDPLATFORM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS trivy-build
ARG TARGETARCH
ENV GOTOOLCHAIN=local
WORKDIR /source
ADD --checksum=sha256:4a5bb1c16ccc55368843eb95ee9a25519a0bfef26609a8b4295f2060af43077e https://codeload.github.com/aquasecurity/trivy/tar.gz/591e9799316a602e703f0b484f6c6d7b234ec8f3 /tmp/trivy.tar.gz
RUN tar -xzf /tmp/trivy.tar.gz --strip-components=1 -C /source && rm /tmp/trivy.tar.gz
RUN --mount=type=cache,target=/go/pkg/mod go get golang.org/x/net@v0.60.0
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOARCH=$TARGETARCH go build -p 2 -trimpath -ldflags "-s -w -X github.com/aquasecurity/trivy/pkg/version/app.ver=0.75.0+cg.1" -o /out/trivy ./cmd/trivy
FROM scratch AS trivy
COPY --from=trivy-build /out/trivy /usr/local/bin/trivy

FROM ${PYTHON_IMAGE} AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project

FROM ${PYTHON_IMAGE} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRIVY_CACHE_DIR=/var/cache/trivy \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

RUN python -m pip uninstall --yes pip \
    && addgroup -g 10001 app \
    && adduser -D -u 10001 -G app -s /sbin/nologin app \
    && mkdir -p /var/cache/trivy \
    && chown app:app /var/cache/trivy

COPY --from=dependencies /app/.venv /app/.venv
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY app/ ./app/

USER 10001:10001
CMD ["python", "-m", "app.jobs.worker"]
